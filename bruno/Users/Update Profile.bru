meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Usuário de Teste Atualizado",
    "email": "usuario@teste.com",
    "institution": "Universidade Federal do Brasil",
    "bio": "Pesquisador em filosofia antiga e contemporânea"
  }
}
