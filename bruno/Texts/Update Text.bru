meta {
  name: Update Text
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/texts/{{textId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  textId: your-text-id-here
}

body:json {
  {
    "title": "Introdução à Metafísica Aristotélica (Atualizado)",
    "content": "Este texto explora os fundamentos da metafísica segundo Aristóteles, abordando conceitos como substância, essência e acidente. A metafísica aristotélica representa uma das mais importantes contribuições para a filosofia ocidental, estabelecendo bases conceituais que perduram até hoje. Através da análise das categorias e do princípio de não-contradição, Aristóteles desenvolve um sistema filosófico robusto que busca compreender a natureza do ser enquanto ser. CONTEÚDO ATUALIZADO.",
    "area": "Metafísica",
    "type": "Artigo",
    "author": "Usuário de Teste",
    "institution": "Universidade Federal",
    "references": "ARISTÓTELES. Metafísica. São Paulo: Edições Loyola, 2002."
  }
}
